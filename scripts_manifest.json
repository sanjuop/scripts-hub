  "scripts": [
    {
      "id": "self_timer",
      "name": "Self Timer (Keep-Alive)",
      "category": "Automation & Keep-Awake",
      "description": "Prevents screen sleep, screensaver, and idle lock with 0% CPU usage. Visibly moves cursor across screen or nudges it in place.",
      "script_file": "self_timer.py",
      "interpreter": "auto",
      "dependencies": [],
      "parameters": [
        {
          "name": "mode",
          "flag": "--mode",
          "type": "choice",
          "label": "Movement Mode",
          "options": ["random", "wiggle", "stealth"],
          "default": "random",
          "help": "Random (jumps across screen), Wiggle (moves back and forth in place), Stealth (no cursor movement)"
        },
        {
          "name": "interval",
          "flag": "--interval",
          "type": "int",
          "label": "Pulse Interval (seconds)",
          "default": 30,
          "min": 1,
          "max": 3600
        },
        {
          "name": "duration",
          "flag": "--duration",
          "type": "int",
          "label": "Run Duration (minutes, 0 = indefinite)",
          "default": 0,
          "min": 0,
          "max": 1440
        },
        {
          "name": "until",
          "flag": "--until",
          "type": "text",
          "label": "Stop At Time (HH:MM:SS, optional)",
          "default": "",
          "placeholder": "e.g. 19:30:00"
        }
      ]
    },
    {
      "id": "whisper_transcriber",
      "name": "Whisper Transcriber",
      "category": "Media & Video",
      "description": "Batch transcribes videos using OpenAI Whisper. Configure output formats (JSON word timestamps, SRT, TXT) and model on the fly.",
      "script_file": "ffmpeg.py",
      "interpreter": "auto",
      "dependencies": ["whisper"],
      "parameters": [
        {
          "name": "dir",
          "flag": "--dir",
          "type": "directory",
          "label": "Target Media Folder",
          "default": "D:\\Lighting\\Tom_Noske_Video_Creator Academy_MP4\\3_Mastering_Scene_Creation_[Practical_Lessons]"
        },
        {
          "name": "formats",
          "flag": "--formats",
          "type": "multi_choice",
          "label": "Output Formats",
          "options": ["json", "srt", "txt", "vtt"],
          "default": ["json"]
        },
        {
          "name": "model",
          "flag": "--model",
          "type": "choice",
          "label": "Whisper Model Size",
          "options": ["tiny", "base", "small", "medium", "large-v3", "turbo"],
          "default": "tiny"
        },
        {
          "name": "language",
          "flag": "--language",
          "type": "text",
          "label": "Audio Language",
          "default": "English"
        },
        {
          "name": "task",
          "flag": "--task",
          "type": "choice",
          "label": "Task",
          "options": ["transcribe", "translate"],
          "default": "transcribe"
        },
        {
          "name": "skip_existing",
          "flag": "--skip-existing",
          "type": "bool",
          "label": "Skip if transcripts already exist",
          "default": true
        },
        {
          "name": "extra_args",
          "flag": "--extra-args",
          "type": "text",
          "label": "Advanced Flags (optional)",
          "default": "",
          "placeholder": "e.g. --device cuda"
        }
      ]
    },
    {
      "id": "video_compressor",
      "name": "Video Compressor",
      "category": "Media & Video",
      "description": "Batch compresses tutorial videos to HEVC (H.265) with CRF rate control and outputs a detailed CSV comparison report.",
      "script_file": "video_compressor.py",
      "interpreter": "auto",
      "dependencies": ["ffmpeg", "ffprobe"],
      "parameters": [
        {
          "name": "input",
          "flag": "--input",
          "type": "directory",
          "label": "Course Video Folder",
          "default": ""
        },
        {
          "name": "mode",
          "flag": "--mode",
          "type": "choice",
          "label": "4K Video Handling",
          "options": ["1080p", "original"],
          "default": "1080p"
        },
        {
          "name": "crf",
          "flag": "--crf",
          "type": "int",
          "label": "CRF Quality (24-32, default 28)",
          "default": 28,
          "min": 18,
          "max": 36
        },
        {
          "name": "preset",
          "flag": "--preset",
          "type": "choice",
          "label": "Preset (Speed vs Compression)",
          "options": ["fast", "medium", "slow"],
          "default": "medium"
        },
        {
          "name": "yes",
          "flag": "--yes",
          "type": "bool",
          "label": "Skip Terminal Confirmation",
          "default": true
        }
      ]
    },
